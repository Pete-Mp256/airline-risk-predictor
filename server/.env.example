PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=incident_risk_predictor
JWT_SECRET=replace_with_a_long_random_string
ML_SERVICE_URL=http://localhost:5001
ML_TIMEOUT_MS=5000
